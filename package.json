{
  "name": "penovtra-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --env-file=.env --watch-path=server server/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env server/db/migrate.js",
    "db:seed": "node --env-file=.env server/db/seed.js",
    "db:seed:demo": "node --env-file=.env server/db/seed-demo.js",
    "db:studio": "node --env-file=.env node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "nodemailer": "^10.6.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.5"
  }
}
