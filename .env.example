# Postgres connection. Locally: the Homebrew Postgres on this machine.
# Production (Vercel): the Neon / Vercel Postgres connection string.
DATABASE_URL=postgres://localhost:5432/penovtra

# Public URL of the site, used in links inside emails
APP_URL=http://localhost:5174

# Email delivery through Resend (https://resend.com). Leave empty locally:
# codes and links are then printed in the API terminal instead of being sent.
RESEND_API_KEY=
MAIL_FROM=PE-NOVTRA <noreply@penovtra.com>

# Google sign-in. Create an OAuth client (type: Web application) in Google Cloud Console
# and register this redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lets POST /api/orders/:id/pay mark an order as paid without a payment gateway.
# Must stay off in production until Midtrans/Xendit is connected.
PAYMENT_MOCK=true

# Port for the local API server (Vite proxies /api to it)
API_PORT=3001
